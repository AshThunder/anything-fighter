# Server-only. Never prefix with NEXT_PUBLIC_ and never commit a real key.
AHOLO_API_KEY=

# Optional Aholo overrides
# AHOLO_API_BASE=https://api.aholo.ai
# AHOLO_MESH_VERSION=G1-Turbo
# AHOLO_MESH_FACES=60000

# Live-forge spend guard (POST /api/pipeline). Defaults shown.
# FORGE_IP_DAILY_LIMIT=2
# FORGE_GLOBAL_DAILY_LIMIT=15
# FORGE_LIMIT_FALLBACK=mock
# "mock" (default): when a cap is hit the forge still runs as a labelled demo forge (no credits).
# "block": HTTP 429 "Forge limit reached, try the roster".

# Durable storage for finished forged fighters (Vercel Blob, private store). Set automatically when a Blob
# store is connected to the project; without it fighters live only in Runtime Cache (can be evicted).
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private

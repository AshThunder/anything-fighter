# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# research raw
refs/lux3d-docs.html
# rehosted generated fighters (large)
public/fighters/gen-*
public/fighters/**/*.orig.glb
public/fighters/test-*/mesh.glb
# baked forged fighters (optimised assets only, committed so they survive Runtime Cache eviction)
!public/fighters/gen-mwejr65q-c81d76/
!public/fighters/gen-mwemw090-24ff0e/
!public/fighters/gen-mwel0i8j-076867/
public/vendor/
public/arenas/*/scan.mp4
public/arenas/room-*
public/arenas/world-*
public/posters/*/posed.glb
public/posters/*/render-v*.png
public/posters/backdrop.glb
luxreal/pack/

# keep the template (no secrets)
!.env.example
# players' uploaded photos stay private (only inside the durable Blob bundle)
public/fighters/gen-*/photo.*

# local moderation queue / runtime data
.data/
